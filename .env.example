# Vestigo environment configuration
# Copy this file to `.env` and adjust values for your environment.
#
# This file is a curated subset. Every setting is also editable by an
# administrator under Administration -> Settings in the web UI, which stores it
# in the database and applies it without a restart. Anything set *here* is
# pinned: the environment always wins, and the console shows the field
# read-only. Use that for the values a deployment must not have changed at
# runtime; leave the rest unset and tune them in the UI.
#
# The authoritative list of every field, its default and its bounds is
# `src/vestigo/core/config.py`; how each one is presented (group, help text,
# env-only/restart-required/secret) is `src/vestigo/core/settings_registry.py`.
# See docs/DEPLOYMENT.md for the precedence rules.

# --- Application ---
VESTIGO_ENVIRONMENT=development
VESTIGO_LOG_LEVEL=INFO
# VESTIGO_ALLOW_ONLINE=false

# Where secrets edited in the admin console may live. "db" (default): admins
# may store passwords/API keys in the app_settings table (plaintext at rest —
# acceptable only if Postgres itself is trusted). "env-only": the settings API
# refuses to store any secret and ignores previously stored ones, leaving these
# variables as the only source. Itself env-only, by design.
# VESTIGO_SECRETS_MODE=db

# --- PostgreSQL (metadata) ---
VESTIGO_POSTGRES_URL=postgresql+asyncpg://vestigo:vestigo@localhost:5432/vestigo

# --- ClickHouse (events) ---
VESTIGO_CLICKHOUSE_URL=http://localhost:8123
VESTIGO_CLICKHOUSE_DATABASE=vestigo
VESTIGO_CLICKHOUSE_USERNAME=default
VESTIGO_CLICKHOUSE_PASSWORD=

# --- Qdrant (vectors) ---
VESTIGO_QDRANT_URL=http://localhost:6333
# VESTIGO_QDRANT_API_KEY=
# VESTIGO_QDRANT_COLLECTION_PREFIX=vestigo
# Set to a directory path to use Qdrant local mode instead of a server
# VESTIGO_QDRANT_PATH=

# --- Embeddings ---
# VESTIGO_EMBEDDING_MODEL=all-MiniLM-L6-v2
# VESTIGO_EMBEDDING_DEVICE=cpu
# VESTIGO_EMBEDDING_BATCH_SIZE=64
# Set VESTIGO_EMBEDDING_API_BASE_URL to use a remote OpenAI-compatible embeddings
# endpoint instead of the local model. VESTIGO_EMBEDDING_MODEL is sent as the
# request's "model" field.
# VESTIGO_EMBEDDING_API_BASE_URL=https://api.openai.com/v1
# VESTIGO_EMBEDDING_API_KEY=

# --- Ingestion ---
# Events per ClickHouse insert during ingestion. One HTTP round-trip per
# batch, so larger batches amortize LAN latency (ClickHouse guidance:
# 10k-100k rows/insert). ~50-150 MB transient memory at the default.
# VESTIGO_INGEST_BATCH_SIZE=20000

# Events read per ClickHouse round-trip while an enrichment job scans a
# source. Enrichment is I/O-bound (every event scanned, not model-bound like
# embedding), so this pages large. On a 180M-event timeline: ~9k round-trips
# at 20000 vs ~180k at the old 1000-row floor. Kept separate from
# VESTIGO_EMBEDDING_BATCH_SIZE on purpose.
# VESTIGO_ENRICHMENT_BATCH_SIZE=20000

# --- Sigma rule runner ---
# Directory of Sigma YAML rules (offline file drop, e.g. a SigmaHQ clone) —
# re-read on every listing/run, no restart needed. Empty/unset disables the
# global set; analysts can still upload per-case rules through the UI.
# VESTIGO_SIGMA_RULES_PATH=/opt/sigma-rules
# Postgres rows per write batch while a Sigma run persists hits.
# VESTIGO_SIGMA_ANNOTATION_BATCH_SIZE=5000

# --- Stories (docs/STORIES.md) ---
# An export resolves every block server-side (one or more ClickHouse queries
# per embed, synchronously in the request) and then stores the browser-rendered
# standalone HTML, so both the work and the stored bytes are bounded.
# Blocks per export; a story over this is refused with 413.
# VESTIGO_STORY_EXPORT_MAX_BLOCKS=500
# Ceiling on the resolved snapshot JSON, enforced block by block *during*
# resolution so an oversized story stops costing memory and queries at the
# block that crosses it rather than after the whole bundle exists. 0 disables.
# VESTIGO_STORY_EXPORT_MAX_SNAPSHOT_BYTES=67108864
# Ceiling on the uploaded HTML artifact, applied to the arriving stream. The
# artifact inlines the compiled stylesheet plus every frozen row.
# VESTIGO_STORY_MAX_ARTIFACT_BYTES=20971520
# Ceiling on one markdown block's text. A block is copied verbatim into every
# later export snapshot, so an unbounded one multiplies across exports.
# VESTIGO_STORY_MAX_MARKDOWN_BYTES=262144

# --- Uploads ---
# Maximum accepted source-upload size in bytes; 0 disables the limit.
# Default: 10 GiB. For very large files (tens of GiB+), prefer server-side
# 'vestigo ingest' over the HTTP upload — no size limit, no temp copy.
# VESTIGO_MAX_UPLOAD_BYTES=10737418240

# --- Case export/import ---
# Master switch. false hides case export/import from the UI entirely and makes
# its endpoints answer 503 — for deployments where a whole-case archive leaving
# the box is a policy problem.
# VESTIGO_TRANSFER_ENABLED=true
# Where in-flight export archives are written before download. They contain
# the full case, so this is as sensitive as the source retention dir; Vestigo
# creates it 0700, forces that mode on an existing directory, and refuses to
# start an export if it is owned by someone else or is not a real directory.
# Size it for the largest case exported. Point it at a directory of its own:
# Vestigo sweeps its own archives and working dirs out of it, and warns about
# anything else it finds there.
# VESTIGO_TRANSFER_TEMP_PATH=data/transfer
# Ceiling on an imported archive's total uncompressed size; 0 disables.
# Default: 200 GiB. Events and blobs travel uncompressed, so a legitimate
# archive expands by roughly 1x — a large ratio is a decompression bomb, not
# a big case. Raise it only if a real case export trips the check.
# VESTIGO_TRANSFER_MAX_EXPANDED_BYTES=214748364800
# Ceiling on any single postgres/* member of an imported archive; 0 disables.
# Default: 2 GiB. Separate from the total above, which says nothing about one
# member — a lone 100 GiB metadata member fits under a 200 GiB total and would
# still exhaust memory. These members hold case metadata (rows, not events),
# so a real export stays far below this.
# VESTIGO_TRANSFER_MAX_METADATA_BYTES=2147483648
# How many case export/import jobs may be in flight at once; 0 disables the
# cap. Any authenticated user can start either, and each holds a multi-GiB
# upload plus everything it expands into for the whole job — this is admission
# control, not a throughput knob. Size TRANSFER_TEMP_PATH for this many
# concurrent archives.
# VESTIGO_TRANSFER_MAX_CONCURRENT=2

# --- Frontend ---
# vestigo-web serves the prebuilt frontend/dist as-is and only builds it (npm
# install + build, requires network/node) when dist/ is missing. Set to 1 to
# force a rebuild after changing frontend sources.
# VESTIGO_FRONTEND_REBUILD=0

# --- Authentication: admin bootstrap ---
# On first startup, if no users exist yet, an administrator account is
# seeded with these credentials. The admin is forced to change the password
# on first login, which invalidates VESTIGO_ADMIN_PASSWORD immediately after —
# treat it as a one-time bootstrap secret, not a long-lived credential.
VESTIGO_ADMIN_USERNAME=admin
# VESTIGO_ADMIN_PASSWORD=

# --- Authentication: login backoff ---
# After this many consecutive failures per (username, client IP), logins are
# rejected with 429 for base*2^(n-threshold) seconds, capped at max.
# VESTIGO_LOGIN_BACKOFF_THRESHOLD=5
# VESTIGO_LOGIN_BACKOFF_BASE_SECONDS=2.0
# VESTIGO_LOGIN_BACKOFF_MAX_SECONDS=300.0

# --- Authentication: sessions ---
# VESTIGO_SESSION_TTL_HOURS=168
# VESTIGO_AUTH_COOKIE_NAME=tv_session
# Set to true when serving over HTTPS (required for the cookie to be sent).
# VESTIGO_AUTH_COOKIE_SECURE=false
# VESTIGO_AUTH_COOKIE_SAMESITE=lax

# --- Authentication: audit log ---
# VESTIGO_AUDIT_ENABLED=true

# --- Authentication: optional OIDC (Authentik, Nextcloud, or any OIDC IdP) ---
# New OIDC logins are auto-provisioned into a team-less "default pool"
# (visible only to themselves) until an admin assigns them to a team.
# Leave OIDC_ENABLED commented out to let an admin toggle SSO in the web
# console — setting it here, even to false, pins the field and makes the
# console toggle a no-op (environment always wins over stored settings).
# VESTIGO_OIDC_ENABLED=false
# ISSUER is the base URL the discovery document hangs off; every other
# endpoint is read from it. Redirects are followed, so the tidy form works.
#   Authentik  https://auth.example.org/application/o/<app-slug>/
#   Nextcloud  https://cloud.example.org   (301s to /index.php/.well-known/...)
#   Keycloak   https://sso.example.org/realms/<realm>
#   Okta       https://<tenant>.okta.com/oauth2/default
#   Google     https://accounts.google.com
# Verify with: curl -sL <issuer>/.well-known/openid-configuration | jq .
# See docs/DEPLOYMENT.md "OIDC single sign-on" for the full walkthrough.
# VESTIGO_OIDC_ISSUER=https://auth.example.org/application/o/vestigo/
# VESTIGO_OIDC_CLIENT_ID=
# VESTIGO_OIDC_CLIENT_SECRET=
# VESTIGO_OIDC_SCOPES=openid email profile
# VESTIGO_OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback

# --- Optional AI investigation agent (docs/AGENT.md) ---
# Off (and invisible in the UI) unless a model + endpoint are configured AND
# the endpoint answers a probe. Independent of VESTIGO_ALLOW_ONLINE — like
# OIDC and the embeddings endpoint, this is an operator-chosen endpoint.
#
# Local ollama example:
# VESTIGO_AGENT_MODEL=qwen3:32b
# VESTIGO_AGENT_PROVIDER=openai
# VESTIGO_AGENT_API_BASE_URL=http://localhost:11434/v1
#
# Kimi coding plan example (Anthropic-protocol endpoint; requires a coding-
# agent User-Agent or the endpoint returns 403). Model IDs: kimi-for-coding,
# k3, kimi-for-coding-highspeed (use the ID, not the version name):
# VESTIGO_AGENT_MODEL=kimi-for-coding
# VESTIGO_AGENT_PROVIDER=anthropic
# VESTIGO_AGENT_API_BASE_URL=https://api.kimi.com/coding
# VESTIGO_AGENT_API_KEY=sk-kimi-...
# VESTIGO_AGENT_USER_AGENT=claude-code/0.1.0
#
# VESTIGO_AGENT_EXTRA_HEADERS={"X-Example":"1"}
# VESTIGO_AGENT_MAX_TURNS=15
# Reasoning effort: off (default) | low | medium | high | max — translated per
# provider (docs/AGENT.md "Reasoning effort"). Env value pins the admin-UI field.
# VESTIGO_AGENT_REASONING_EFFORT=high
# Model context window in tokens (>=1024). When set, older tool results are
# elided from what the model sees before a request can overflow it (the stored
# transcript stays complete). Unset = the sliding window only engages after an
# overflow, costing one failed round trip
# (docs/AGENT.md "Sliding context window"):
# VESTIGO_AGENT_CONTEXT_WINDOW=200000
# How much of each event record the agent gets back (searches, similarity
# lookups, anomaly findings; get_event always answers in full):
#   full (default) | message | minimal | auto (derive from the context window:
#   >=100k full, >=32k message, smaller minimal, window unset message).
# Unset means "no constraint declared" and assumes a large cloud window; set
# message or auto for a small local model. On an overflow the turn retries one
# level down automatically, so this costs a slower turn, never a lost one:
# VESTIGO_AGENT_TOOL_FIDELITY=auto
# Tool names to hard-deny everywhere (in-app agent AND /mcp), JSON array:
# VESTIGO_AGENT_DISABLED_TOOLS=["semantic_search","similar_events"]
# Availability probe cache TTL in seconds:
# VESTIGO_AGENT_PROBE_TTL_SECONDS=60
# Wall clock for one model request inside an agent turn. Raise it for a slow
# local endpoint; the stranded-turn sweep scales with it automatically:
# VESTIGO_AGENT_REQUEST_TIMEOUT_SECONDS=300
# Ceiling for the one-shot "suggest columns with AI" call, probe included. On
# expiry the timeline keeps its locally scored columns:
# VESTIGO_COLUMN_ADVISOR_TIMEOUT_SECONDS=45
# Ceiling for one converter generation or repair round (docs/INPUT_FORMATS.md
# §"Generated converters"). A large local model writing a whole script is the
# case that needs this raised:
# VESTIGO_CONVERTER_GENERATION_TIMEOUT_SECONDS=180
# Where the LLM API key may live: db (default; admins can store it in Postgres,
# plaintext at rest) or env-only (DB storage refused, any previously stored key
# ignored — VESTIGO_AGENT_API_KEY becomes the only source). Recommended for
# deployments where the Postgres host is less trusted than the app host:
# VESTIGO_AGENT_SECRET_MODE=env-only
#
# All VESTIGO_AGENT_* fields above are also editable in the admin UI (the
# endpoint/model/tool policy on Admin -> Agent, the rest on Admin -> Settings);
# a set env var always wins over the DB value and shows as "pinned" there.

# --- External MCP endpoint (docs/AGENT.md) ---
# Serve the agent's tool set to external MCP clients over /mcp (streamable
# HTTP, per-timeline bearer tokens). Off by default; independent of the
# VESTIGO_AGENT_* settings above.
# VESTIGO_MCP_ENABLED=true

# Outside-facing URL of this deployment. Links Vestigo hands to something that
# is not the browser -- the Visualize deep link an external MCP client gets
# back from a chart -- are absolute when this is set, and relative paths
# (which an MCP client cannot resolve) when it is not. Not derived from the
# request Host header on purpose: behind a proxy that is whatever the proxy
# forwarded, and a confidently wrong link is worse than a relative one.
# VESTIGO_PUBLIC_BASE_URL=https://vestigo.example.org

# --- Heavy ClickHouse scan guardrails ---
# All editable in the admin console and applied on the next scan, except
# VESTIGO_STAT_SCAN_CONCURRENCY, which sizes the admission semaphore at import
# and is restart-required.
#
# Total memory budget shared by all concurrent scans; each heavy query gets
# budget / (VESTIGO_STAT_SCAN_CONCURRENCY + 2) as its max_memory_usage — the
# two extra slots are the chart lane (four foreground queries at half a heavy
# cap each), which never queues behind a detector sweep.
#
# 0 = auto, and auto now means VESTIGO_STAT_SCAN_MEMORY_RATIO of *the ceiling
# ClickHouse reports for itself* — read from the server at startup, so it
# describes the machine the queries actually run on. Set
# max_server_memory_usage there (deploy/clickhouse/memory.xml is mounted by both
# compose files) and this follows it; there is no second number to keep in sync.
#
# Only if ClickHouse reports no ceiling does the app fall back to measuring its
# own container — and in a full-docker stack that reads the whole host and sizes
# a budget as if ClickHouse owned the box, while Postgres, Qdrant and the app
# share it. On a 64 GiB host that is 25.6 GiB granted to one query. The app logs
# a warning at startup when it lands there, and /api/health carries a
# `scan_budget` block saying which path it took. Pin a byte value only to
# override the derived one — see docs/DEPLOYMENT.md "Resource sizing".
# VESTIGO_STAT_SCAN_MAX_MEMORY_BYTES=0
# Fraction of ClickHouse's ceiling the automatic budget claims. The remainder is
# headroom for what a per-query cap cannot bound: background merges, the mark
# and uncompressed caches, allocator slack.
# VESTIGO_STAT_SCAN_MEMORY_RATIO=0.8
# Max heavy scans running at once; the rest queue in the app. The enrichment
# partition rewrite takes a slot too, not just detectors. Charts (histogram,
# top terms, numeric stats) have their own four-slot lane. Restart-required.
# VESTIGO_STAT_SCAN_CONCURRENCY=2
# ClickHouse max_threads per heavy scan.
# VESTIGO_STAT_SCAN_MAX_THREADS=8
# Spill-to-disk thresholds. Clamped to half the per-query cap, so spilling
# always engages before the cap kills the query. Window-function sorts cannot
# spill at all and are bounded structurally instead.
# VESTIGO_STAT_SCAN_EXTERNAL_GROUP_BY_BYTES=4000000000
# VESTIGO_STAT_SCAN_EXTERNAL_SORT_BYTES=4000000000
# Seconds a value-inventory export waits for the single streamed-export slot
# before the request is refused with 503. That slot is held for the whole
# download, which the analyst's browser paces, so the wait has to be bounded:
# an unbounded one lets one backgrounded download block every other export in
# the process, each queued one parked on a shared worker thread. 0 refuses
# immediately when an export is already streaming.
# VESTIGO_EXPORT_SCAN_QUEUE_WAIT_SECONDS=30
# Seconds the enrichment partition rewrite keeps its scan slot after the swap,
# waiting out the merges the swap queued. `ALTER TABLE ... REPLACE PARTITION`
# returns before those merges run, and merge memory is the one consumer no
# per-query cap reaches — so releasing the slot at the swap admits the next
# sweep straight into them. Scoped to the partition the apply wrote, so an
# instance with concurrent ingest does not wait out merges that are not ours. Bounded and non-fatal: the partition is already
# durable, so a slow merge never fails a completed apply. 0 skips the wait,
# which is right when ClickHouse has a max_server_memory_usage of its own.
# VESTIGO_ENRICHMENT_APPLY_MERGE_WAIT_SECONDS=300
# Write-side bound for the enrichment partition rewrite, which INSERTs a full
# copy of a source's partition. This is a squash floor: rows accumulate until a
# block reaches at least this size before a part is written. Lower it to trade
# more (smaller) parts and more merge work for less insert-time memory. Set
# below ClickHouse's own 256 MiB default on purpose. Unlike the scan settings
# above, editing this one does not need a restart.
# VESTIGO_ENRICHMENT_APPLY_INSERT_BLOCK_BYTES=67108864
